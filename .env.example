# Copy to `.env.local` and fill in. Never put real keys in this file.
#
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio -> Get API key. Free tier, no credit card.
# Server-only: read in app/api/mascot/route.ts and never sent to the browser.
# Never rename this with a NEXT_PUBLIC_ prefix — that would ship the key.
GEMINI_API_KEY=

# Deliberately absent:
#   - Resend / SMTP credentials -> live in the Supabase dashboard, not here.
#     Supabase sends the auth emails; this app only asks it to.
#   - service_role key -> bypasses all Row Level Security. Never in this app.
